---
// A half sun with horizontal bands on a horizon line, in CSS only: the Ask screen's one larger decoration. Static (never animated), no text, no image.
---

<div class="sunset" aria-hidden="true"></div>

<style>
  /* The block's height is fixed in rem (no image, no font, no script), so nothing moves when the page finishes loading. */
  .sunset {
    --sun: 3.25rem; /* the sun's height: half of its width */
    position: relative;
    block-size: var(--sun);
    margin-block-start: var(--space-2);
    border-block-end: 2px solid transparent;
    border-image: linear-gradient(to right, transparent, var(--accent) 35%, var(--accent-2) 75%, transparent) 1; /* the horizon: the header rule's two colours */
  }
  .sunset::before {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 12%;
    inline-size: calc(var(--sun) * 2);
    block-size: var(--sun);
    border-radius: var(--sun) var(--sun) 0 0;
    background: linear-gradient(to bottom, var(--accent) 0%, var(--accent-2) 100%);
    mask: var(--sun-bands);
    opacity: 0.9;
  }
  /* Large text on a phone: the container is few em wide (em here is the text size), so the sun gives the first screen back to Next up. */
  @container (max-width: 17em) {
    .sunset { --sun: 1.75rem; margin-block-start: 0; }
  }
  @container (min-width: 36rem) {
    .sunset { --sun: 4.5rem; }
  }
  @container (min-width: 60rem) {
    .sunset { --sun: 5.5rem; }
  }
</style>
