---
// The gate address of a hidden-tier page (what links, search results and a typed address reach). It says what kind of
// content is behind it and that the spoiler setting is below it, and holds none of that content: nothing in the title,
// description, headings or links comes from the record. Show is a plain link to the explicit address (`show`) with the
// reveal marker the server needs below the tier. With script, a dial at or above the tier forwards there (reveal.js).
import './HiddenGuard.css';

interface Props {
  tier: 'places' | 'mild';
  show: string; // the explicit address, e.g. /places/<id>/show/
}
const { tier, show } = Astro.props;
const copy = {
  places: { kind: 'a places page', level: 'Places' },
  mild: { kind: 'a mild gameplay detail', level: 'Mild' },
}[tier];
---

<div class="guard" data-gate={tier}>
  <h1>Hidden page</h1>
  <p>This is {copy.kind}. It stays closed because the spoiler setting is below {copy.level}. Open the Spoilers button at the top and choose {copy.level} to see it.</p>
  <a class="guard__show" href={`${show}?reveal=1`}>Show this page</a>
  <a class="guard__back" href="/">Go back to Ask</a>
</div>

<script>
  import '../scripts/reveal.js';
</script>
