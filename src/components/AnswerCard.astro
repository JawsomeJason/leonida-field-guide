---
// Compact card for cheat sheets and lists; `full` is the answer page. Same data, two sizes.
import ConsoleText from './ConsoleText.astro';
import Reveal from './Reveal.astro';
import OtherConsoles from './OtherConsoles.astro';
import ConsoleName from './ConsoleName.astro';
import OutsideList from './OutsideList.astro';
import { consoles, consoleIds } from '../data/consoles.js';
import { onlyOf } from '../lib/console.js';
import { confidence } from '../data/confidence.js';
import { pathOf, renderBody, type AnswerData } from '../lib/answers';
import './AnswerCard.css';

interface Props {
  answer: AnswerData;
  full?: boolean;
  related?: AnswerData[];
}
const { answer: a, full = false, related = [] } = Astro.props;

const only = a.consoles === 'all' ? '' : `${a.consoles.map((c) => consoles[c].name).join(' and ')} only`;
const trust = confidence[a.confidence];
const checked = new Date(`${a.checked}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const body = full && a.body ? await renderBody(a.body) : '';
---

{full ? (
  <article class="answer">
    <h1 class="answer__q">{a.question}</h1>
    {a.byConsole && (
      <fieldset class="setting needs-js">
        <legend>Console</legend>
        <div class="ctabs">
          {consoleIds.map((id) => <button type="button" data-set="console" data-value={id}><ConsoleName id={id} /></button>)}
        </div>
      </fieldset>
    )}
    <p class="answer__a"><ConsoleText text={a.short} byConsole={a.byConsole} /></p>
    {only && <p class="answer__note">{only}</p>}
    {body && <div class="prose" set:html={body} />}
    <Reveal answer={a} />
    <dl class="facts">
      <div>
        <dt>How sure we are</dt>
        <dd>
          <p class="trust__now"><strong>{trust.label}, {trust.short}</strong></p>
          <p class="label-key">Official: from the publisher or the console maker. Reported: from a news or guide site.</p>
          <details class="trust">
            <summary>What does this mean?</summary>
            <p>{trust.text}</p>
          </details>
        </dd>
      </div>
      <div><dt>Checked</dt><dd><time datetime={a.checked}>{checked}</time></dd></div>
      <div>
        <dt>Sources</dt>
        <dd><OutsideList links={a.sources.map((s) => ({ href: s.url, title: s.title, console: s.console }))} /></dd>
      </div>
    </dl>
    {related.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related">Related</h2>
        <ul class="tap-list">{related.map((b) => <li data-only={onlyOf(b.consoles)}><a href={pathOf(b)}>{b.question}</a></li>)}</ul>
        <OtherConsoles items={related.map((b) => ({ ...b, label: b.question }))} />
      </section>
    )}
  </article>
) : (
  <article class="card" id={a.id}>
    <div class="card__in">
      <h2 class="card__q"><a href={pathOf(a)}>{a.question}</a></h2>
      <p class="card__a"><ConsoleText text={a.short} byConsole={a.byConsole} /></p>
      {(only || a.tier !== 'none') && <p class="card__meta">{[a.tier === 'none' ? '' : a.tier === 'places' ? 'Places' : 'Mild', only].filter(Boolean).join(', ')}</p>}
      {a.tier !== 'none' && <p class="card__meta">Source, date checked and how sure we are: open the answer.</p>}
    </div>
    <Reveal answer={a} />
  </article>
)}
