---
import { stages } from '../data/stages';
import OtherConsoles from './OtherConsoles.astro';
import { onlyOf } from '../lib/console.js';
import type { AnswerData } from '../lib/answers';

interface Props {
  todos: AnswerData[]; // in the order the Checklist uses too
}
const { todos } = Astro.props;
// Short names fit four across at 320px; the full name heads each list.
const short: Record<string, string> = { before: 'Before', 'hour-1': 'Hour 1', 'day-1': 'Day 1', 'week-1': 'Week 1' };
---

<section class="stages" aria-labelledby="stage-title">
  <h2 id="stage-title">Your stage</h2>

  {/* The picker saves through settings.js, so it needs script. Without it every stage's list shows below. */}
  <fieldset class="stage-pick needs-js">
    <legend class="sr-only">Where are you in the game?</legend>
    <div class="seg">
      {stages.map((s) => (
        <label>
          <input type="radio" name="stage" value={s.id} data-setting checked={s.id === 'before'} />
          {short[s.id]}
        </label>
      ))}
    </div>
  </fieldset>

  {/* With a console chosen the full list folds behind one row (home-todos.js writes the count); without script, or before a console is chosen, it stays open and the row is hidden. The inline line sets the first state before paint. */}
  <details class="stage-fold" open>
    <summary>See all steps</summary>
    <script is:inline>document.currentScript.parentElement.open = !document.documentElement.dataset.console;</script>
  {
    stages.map((s) => {
      const items = todos.filter((t) => t.stage === s.id);
      return (
        <div class="stage" data-stage={s.id}>
          <h3>
            {s.label} <span class="stage__count" data-count />
          </h3>
          {items.length === 0 ? (
            <p class="stage__empty">Nothing to do here yet.</p>
          ) : (
            <>
              {/* Script on: tick boxes. Script off: plain links to the answers. */}
              <ul class="tap-list todo-list needs-js">
                {items.map((t) => (
                  <li class="todo" data-only={onlyOf(t.consoles)}>
                    <label>
                      <input type="checkbox" data-todo={t.id} />
                      <span>{t.todo}</span>
                    </label>
                    <a class="todo__open" href={`/a/${t.id}/`} aria-label={`Open the answer: ${t.todo}`}>
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                  </li>
                ))}
              </ul>
              <ul class="tap-list todo-links">
                {items.map((t) => <li data-only={onlyOf(t.consoles)}><a href={`/a/${t.id}/`}>{t.todo}</a></li>)}
              </ul>
              <OtherConsoles items={items.map((t) => ({ ...t, label: t.todo! }))} />
            </>
          )}
        </div>
      );
    })
  }
  </details>
</section>

<script>
  import '../scripts/home-todos.js';
</script>

<style is:global>
  .stages { margin-block-end: var(--space-6); }
  .stage-pick { margin-block-end: var(--space-4); }
  .stage-pick .seg { flex-basis: 100%; }
  @media (max-width: 37.5em) { .stage-pick .seg { display: grid; grid-template-columns: 1fr 1fr; } } /* two by two: four labels never wrap at 320 */
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .stage h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-3); margin: 0 0 var(--space-3); font-size: var(--text-body); }
  .stage__count { color: var(--muted); font: var(--font-label); }
  .stage__empty { margin: 0; color: var(--muted); }
  html:not(.js) .stage { margin-block-end: var(--space-5); }
  html.js .todo-links { display: none; }

  /* The fold's row: a raised row ending on the chevron the other rows end on, turned down while open. Shown only with script and a console. */
  .stage-fold > summary { display: none; }
  html.js[data-console] .stage-fold > summary:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: var(--tap);
    padding-inline: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    font: 650 var(--text-body) / 1.2 var(--font-text);
    cursor: pointer;
    list-style: none;
  }
  .stage-fold > summary::-webkit-details-marker { display: none; }
  .stage-fold > summary::after {
    content: '';
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    background: var(--muted);
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='m9 6 6 6-6 6'/></svg>") no-repeat center / contain;
  }
  .stage-fold[open] > summary::after { rotate: 90deg; }
  html.js[data-console] .stage-fold[open] > summary { margin-block-end: var(--space-4); }
  html.js[data-console] .stage-fold > summary:hover { background-color: var(--wash); }

  /* With script, the picker's checked radio decides which stage shows. */
  html.js .stage { display: none; }
  .stages:has([name='stage'][value='before']:checked) .stage[data-stage='before'],
  .stages:has([name='stage'][value='hour-1']:checked) .stage[data-stage='hour-1'],
  .stages:has([name='stage'][value='day-1']:checked) .stage[data-stage='day-1'],
  .stages:has([name='stage'][value='week-1']:checked) .stage[data-stage='week-1'] { display: block; }

  /* Row: the label is the big target; the small arrow on the end opens the answer. */
  .todo-list .todo { display: grid; grid-template-columns: minmax(0, 1fr) var(--tap); gap: var(--space-4); } /* 16px between the tick row and the arrow */
  .todo-list .todo label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--tap);
    margin-block: calc(var(--gap-tap) / 2);
    margin-inline-start: calc(var(--space-2) * -1);
    padding: var(--space-2);
    cursor: pointer;
  }
  .todo-list .todo a.todo__open { justify-content: center; padding: 0; margin-inline: 0; border-inline-start: 0; color: var(--muted); }

  @media (prefers-reduced-motion: no-preference) {
    html.js .stage { animation: stage-in 160ms var(--ease-out); }
  }
  @keyframes stage-in { from { opacity: 0; translate: 0 0.25rem; } }
</style>
