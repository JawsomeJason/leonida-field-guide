---
// An empty mount for the outside map links and the dated line. They live in the Places tier (/h/places/maps/); maps.js fills this
// only while the dial is Places or Mild. Nothing about any map site is in this markup. Data: src/data/outside-maps.js.
import './OutsideLink.css';
---

<div class="maps" data-maps></div>

<script>
  import '../scripts/maps.js';
</script>

<style is:global>
  .maps:not(:empty) { margin-block-start: var(--space-5); } /* clear of a list above it */
  .maps__line { margin-block: var(--space-2) var(--space-5); color: var(--muted); font: var(--font-label); max-inline-size: 40rem; }
</style>
