---
interface Props {
  answers: { id: string; question: string }[];
}
const { answers } = Astro.props;
import OutsideLink from './OutsideLink.astro';
---

<search class="ask-search">
  <form id="ask" action="/" method="get">
    <input
      id="q"
      name="q"
      type="search"
      aria-labelledby="ask-title"
      placeholder="Type a question"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="none"
      spellcheck="false"
      enterkeyhint="search"
    />
  </form>
  <p id="q-status" role="status" class="ask-status"></p>
  <div id="q-where" hidden>
    <p>Places are hidden by design, so this guide does not say where things are. Turn them on, or use a map.</p>
    <ul class="tap-list">
      <li><a href="/places/">Places: turn them on</a></li>
      <li><OutsideLink href="https://gtamap.io" title="gtamap.io" /></li>
      <li><OutsideLink href="https://fullsweepmap.com" title="FullSweep" /></li>
    </ul>
  </div>
  <h2 id="q-related" class="ask-related" hidden>Possibly related</h2>
  <ul id="q-results" class="tap-list ask-rows" hidden></ul>
  <button id="q-more" type="button" class="ask-more" hidden>Show more</button>
</search>

{/* No-script floor: every default answer, as links. With script, the search results replace it. */}
<section class="ask-all" aria-labelledby="all-title">
  <h2 id="all-title">All answers</h2>
  <ul class="tap-list ask-rows">
    {answers.map((a) => <li><a href={`/a/${a.id}/`}>{a.question}</a></li>)}
  </ul>
</section>

<script>
  import '../scripts/search.js';
</script>

<style is:global>
  /* The memorable thing on this screen: a big, calm search field. Everything else stays quiet. */
  .ask-search input {
    inline-size: 100%;
    min-block-size: 3.5rem;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--muted);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: max(var(--text-input), 1.25rem);
    -webkit-appearance: none;
    appearance: none;
    box-shadow: var(--shadow);
  }
  .ask-search input:focus-visible { outline-offset: 3px; border-color: var(--accent); }
  .ask-search input::placeholder { color: var(--muted); opacity: 1; }
  .ask-status { min-block-size: 1.5rem; margin: var(--space-2) 0 var(--space-1); color: var(--muted); font-size: var(--text-small); }
  .ask-status[data-floor] { color: var(--text); font: 600 var(--text-body) / 1.4 var(--font-text); } /* the no-answer line is the message, not a footnote */
  .ask-search ul { margin-block-end: var(--space-5); }
  .ask-search [hidden] { display: none; } /* .tap-list's display would otherwise beat the hidden attribute */
  .ask-related { margin: var(--space-3) 0 var(--space-1); font: var(--font-label); color: var(--muted); } /* quiet: it says these are not the answer */
  .ask-more {
    min-block-size: var(--tap);
    padding-inline: var(--space-5);
    margin-block: 0 var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--accent);
    font: 600 var(--text-body) / 1 var(--font-text);
    cursor: pointer;
    touch-action: manipulation;
  }
  .ask-more:active { scale: var(--press-scale-small); background: var(--press); }
  #q-where p { margin: 0 0 var(--space-2); }

  .tap-list.ask-rows a { flex-direction: column; align-items: flex-start; justify-content: center; }
  .ask-rows .q { color: var(--text); }
  .ask-rows .s { color: var(--muted); font-size: var(--text-small); line-height: 1.35; }

  html.js .ask-all { display: none; }
  .ask-all { margin-block-start: var(--space-5); }
</style>
