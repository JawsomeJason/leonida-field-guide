---
interface Props {
  answers: { id: string; question: string }[];
}
const { answers } = Astro.props;
import OutsideMaps from './OutsideMaps.astro';
import './Reveal.css';
import { mapsOffLine } from '../data/outside-maps.js';
---

<search class="ask-search">
  <form id="ask" action="/" method="get">
    <input
      id="q"
      name="q"
      type="search"
      aria-labelledby="ask-title"
      placeholder="Type a question"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="none"
      spellcheck="false"
      enterkeyhint="search"
    />
    {/* Our own clear control instead of the browser's blue cross (hidden below): shown only while the field holds text (CSS, :placeholder-shown), so the form needs no script to work. */}
    <button type="button" class="ask-clear needs-js" aria-label="Clear search"></button>
  </form>
  <p id="q-status" role="status" class="ask-status"></p>
  {/* The where-is note (search.js): its sentence is copied in from one of these two templates while the query asks where something is, so a note that does not apply is not in the page at all. */}
  <div id="q-where" hidden>
    <OutsideMaps />
  </div>
  <template id="q-where-off">
    <div class="where-off">
      <p>Places are hidden by design. {mapsOffLine}</p>
      <ul class="tap-list">
        <li><a href="/places/">Places: turn them on</a></li>
      </ul>
    </div>
  </template>
  <template id="q-where-on">
    <div class="where-on"><p>Places are shown at your level.</p></div>
  </template>
  <ul id="q-results" class="tap-list ask-rows" hidden></ul>
  <button id="q-more" type="button" class="ask-more" hidden>Show more</button>
</search>

{/* No-script floor: every default answer, as links. With script, the search results replace it. */}
<section class="ask-all" aria-labelledby="all-title">
  <h2 id="all-title">All answers</h2>
  <ul class="tap-list ask-rows">
    {answers.map((a) => <li><a href={`/a/${a.id}/`}>{a.question}</a></li>)}
  </ul>
</section>

<script>
  import '../scripts/search.js';
  import '../scripts/search-clear.js';
</script>

<style is:global>
  /* The memorable thing on this screen: a big, calm search field. Everything else stays quiet. */
  .ask-search input {
    inline-size: 100%;
    min-block-size: 3.5rem;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--muted);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: max(var(--text-input), 1.25rem);
    -webkit-appearance: none;
    appearance: none;
    box-shadow: var(--shadow);
  }
  /* The clear button sits beside the field, 8px away (--gap-tap), never on top of it: two targets that touch fail the touch rule. While the field is empty it is not there and the field is the whole row. */
  .ask-search form { display: flex; align-items: center; gap: var(--gap-tap); }
  .ask-search input { flex: 1 1 auto; min-inline-size: 0; }
  .ask-search input::-webkit-search-cancel-button { appearance: none; display: none; }
  .ask-clear {
    flex: none;
    display: none;
    inline-size: var(--tap);
    block-size: var(--tap);
    padding: 0;
    border: 1px solid var(--edge);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
  }
  .ask-clear::before { /* the cross, drawn in CSS: it takes the text colour in both themes */
    content: '';
    display: block;
    margin: auto;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    background: currentColor;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round'><path d='m6 6 12 12M18 6 6 18'/></svg>") no-repeat center / contain;
  }
  html.js .ask-search form:has(input:not(:placeholder-shown)) .ask-clear { display: block; }
  .ask-clear:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .ask-clear:active { background-color: var(--press); }
  @media (hover: hover) and (pointer: fine) { .ask-clear:hover { background-color: var(--wash); } }
  .ask-search input:focus-visible { outline-offset: 3px; border-color: var(--accent); }
  .ask-search input::placeholder { color: var(--muted); opacity: 1; }
  .ask-status { min-block-size: 1.5rem; margin: var(--space-2) 0 var(--space-1); color: var(--muted); font-size: var(--text-small); }
  .ask-status[data-floor] { color: var(--text); font: 600 var(--text-body) / 1.4 var(--font-text); } /* the no-answer line is the message, not a footnote */
  .ask-search ul { margin-block-end: var(--space-5); }
  .ask-search [hidden] { display: none; } /* .tap-list's display would otherwise beat the hidden attribute */
  .ask-more {
    min-block-size: var(--tap);
    padding-inline: var(--space-5);
    margin-block: 0 var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--accent);
    font: 600 var(--text-body) / 1 var(--font-text);
    cursor: pointer;
    touch-action: manipulation;
  }
  .ask-more:active { scale: var(--press-scale-small); background: var(--press); }
  #q-where p { margin: 0 0 var(--space-2); }

  .tap-list.ask-rows a { flex-direction: column; align-items: flex-start; justify-content: center; }
  .ask-rows .q { color: var(--text); font-weight: 650; } /* a step heavier than the snippet under it */
  .ask-rows .s { color: var(--muted); font-size: var(--text-small); font-weight: 400; line-height: 1.35; }

  /* A result that warns of a loss is a card: the answer link, then the one filled button under it. Two controls, 8px apart. */
  .ask-rows li.ask-loss { padding: 0 var(--space-4) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .ask-rows li.ask-loss::after { display: none; }
  .tap-list.ask-rows li.ask-loss a:not(.reveal__btn) { margin: 0; padding-inline: 0 1.75rem; border-inline-start: 0; }
  .ask-rows li.ask-loss a:not(.reveal__btn)::after { inset-inline-end: 0; }
  .ask-rows li.ask-loss .reveal { margin-block-start: var(--gap-tap); }
  /* The button is an <a> inside .tap-list: take back the list row's margin, padding, left edge and arrow. */
  .tap-list.ask-rows li.ask-loss .reveal__btn { margin: 0; padding: var(--space-2) var(--space-4); border: 1px solid var(--action); align-items: center; }
  .tap-list.ask-rows li.ask-loss .reveal__btn::after { display: none; }

  /* The known-problems row ahead of the answers: a raised row with the arrow the checklist rows end on, like the other primary rows. */
  .ask-rows li.ask-known { margin-block-end: var(--gap-tap); border-block-end: 0; }
  .ask-rows li.ask-known a {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-weight: 600;
  }
  .ask-known a::after {
    content: '';
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    background: var(--muted);
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='m9 6 6 6-6 6'/></svg>") no-repeat center / contain;
  }

  html.js .ask-all { display: none; }
  .ask-all { margin-block-start: var(--space-5); }
</style>
