---
// One link to another site: its title, then its host, so the target is read before the tap. The shared note about spoilers is
// said once per list (OutsideList.astro), not on every link.
import './OutsideLink.css';

interface Props {
  href: string;
  title: string;
  about?: string;
}
const { href, title, about } = Astro.props;
const host = new URL(href).hostname.replace(/^www\./, '');
---

<a class="outside" href={href} rel="noopener">
  <span class="outside__title">{title}</span>
  {about && <span class="outside__about">{about}</span>}
  {host !== title && <span class="outside__host">{host}</span>}
</a>
