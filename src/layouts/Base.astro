---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Leonida Field Guide';
const {
  title,
  description = 'An unofficial, spoiler-safe second-screen guide for Grand Theft Auto VI.',
} = Astro.props;
const fullTitle = title ? `${title} · ${site}` : site;
const path = Astro.url.pathname;
const hasList = Astro.slots.has('list');

const nav = [
  { href: '/', label: 'Ask' },
  { href: '/topics/', label: 'Topics' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/new/', label: 'New' },
];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const dial = [['off', 'Off'], ['places', 'Places'], ['mild', 'Mild']];
const consoles = [['ps5', 'PS5'], ['xbox-x', 'Xbox X'], ['xbox-s', 'Xbox S']];
const themes = [['system', 'Auto'], ['day', 'Day'], ['night', 'Night']];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="text-scale" content="scale" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6efe2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181320" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Applies saved settings before first paint, so the theme does not flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        // Saved state is v2 ({ settings: { theme: { value, at } } }); an old tab may still have written { theme }.
        var s = JSON.parse(localStorage.getItem('lfg:v1')), h = document.documentElement;
        for (var k of ['theme', 'console', 'dial']) {
          var v = s.settings ? s.settings[k] && s.settings[k].value : s[k];
          if (v && v !== 'system') h.dataset[k] = v;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__row">
        <a class="site-name" href="/">{site}</a>
        <fieldset class="dial" aria-describedby="dial-help">
          <legend>Spoilers</legend>
          <div class="seg">
            {dial.map(([value, label]) => (
              <label><input type="radio" name="dial" value={value} data-setting checked={value === 'off'} />{label}</label>
            ))}
          </div>
        </fieldset>
        {/* Always shows the console in use. Opens the settings sheet (a native popover: Esc, a tap outside and Done close it). */}
        <button class="chip needs-js" type="button" popovertarget="settings">
          <span class="sr-only">Settings: </span>
          {consoles.map(([value, label]) => <span data-c={value}>{label}</span>)}
          <span data-c="">Console</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 15 6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </header>

    <div id="settings" class="sheet needs-js" popover role="dialog" aria-labelledby="settings-title">
      <div class="sheet__in">
        <h2 id="settings-title">Settings</h2>
        <fieldset class="setting">
          <legend>Console</legend>
          <div class="seg">
            {consoles.map(([value, label]) => (
              <label><input type="radio" name="console" value={value} data-setting />{label}</label>
            ))}
          </div>
        </fieldset>
        <fieldset class="setting">
          <legend>Theme</legend>
          <div class="seg">
            {themes.map(([value, label]) => (
              <label><input type="radio" name="theme" value={value} data-setting checked={value === 'system'} />{label}</label>
            ))}
          </div>
        </fieldset>
        <section id="dial-help" class="dial-help" aria-labelledby="dial-help-title">
          <h3 id="dial-help-title">What the spoiler dial shows</h3>
          <dl>
            <dt>Off</dt><dd>how-to answers only</dd>
            <dt>Places</dt><dd>adds where things are</dd>
            <dt>Mild</dt><dd>adds light gameplay hints</dd>
          </dl>
        </section>
        <button type="button" class="btn" popovertarget="settings" popovertargetaction="hide">Done</button>
      </div>
    </div>

    <div class:list={['frame', { 'frame--list': hasList }]}>
      <nav class="nav" aria-label="Main">
        {nav.map(({ href, label }) => (
          <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      {hasList && <aside class="list" aria-label="More in this topic"><slot name="list" /></aside>}
      <main class="main"><slot /></main>
    </div>

    <footer class="site-footer">
      <p>
        Leonida Field Guide is an unofficial fan project. It is not affiliated with or endorsed by
        Rockstar Games or Take-Two Interactive.
      </p>
      <a class="footer-link" href="/about/">About</a>
    </footer>

    <script>
      import '../scripts/settings.js';
      import '../scripts/sync.js';
      import '../scripts/offline.js';
      import '../scripts/panel.js';
    </script>
  </body>
</html>
