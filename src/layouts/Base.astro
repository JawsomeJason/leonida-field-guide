---
import '../styles/global.css';
import ConsoleName from '../components/ConsoleName.astro';
import { consoleIds, consoles } from '../data/consoles.js';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Leonida Field Guide';
const {
  title,
  description = 'An unofficial, spoiler-safe second-screen guide for Grand Theft Auto VI.',
} = Astro.props;
const fullTitle = title ? `${title} · ${site}` : site;
const path = Astro.url.pathname;
const hasList = Astro.slots.has('list');

const nav = [
  { href: '/', label: 'Ask' },
  { href: '/topics/', label: 'Topics' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/new/', label: 'New' },
];
// The tab is the section: Ask holds /, /a/** and /search; Topics /topics/**; Checklist; New. Answers are reached from Ask, so Ask stays lit there.
const current = (href: string) => (href === '/' ? /^\/(a\/|search|$)/.test(path) : path.startsWith(href));

const dial = [
  ['off', 'Off', 'the basics: setup, settings, controls, saving, fixes'],
  ['places', 'Places', 'adds where things are'],
  ['mild', 'Mild', 'adds how the game\'s systems work in play'],
];
const themes = [['system', 'Auto'], ['day', 'Day'], ['night', 'Night']];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="text-scale" content="scale" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6efe2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181320" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Applies saved settings before first paint, so the theme does not flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        // Saved state is v2 ({ settings: { theme: { value, at } } }); an old tab may still have written { theme }.
        var s = JSON.parse(localStorage.getItem('lfg:v1')), h = document.documentElement;
        for (var k of ['theme', 'console', 'dial']) {
          var v = s.settings ? s.settings[k] && s.settings[k].value : s[k];
          if (v && v !== 'system') h.dataset[k] = v;
        }
      } catch (e) {}
      // A tap on a setting control, or on a tick box, before the bundled scripts have arrived (a slow phone waits seconds): save and show it here.
      // settings.js removes these listeners when it loads, re-applies the saved state and writes the early ticks.
      // shortcut: a pre-v2 saved shape is left for settings.js to convert (that tap shows, but is not stored), drop once no device holds one.
      (function () {
        var ticks = (window.lfgTicks = {});
        function put(k, v) {
          try {
            var s = JSON.parse(localStorage.getItem('lfg:v1')) || { v: 2, settings: {}, items: {} }, was = s.settings && s.settings[k];
            if (s.v === 2) {
              s.settings[k] = { value: v, at: Math.max(Date.now(), (was ? was.at : -1) + 1) };
              localStorage.setItem('lfg:v1', JSON.stringify(s));
            }
          } catch (e) {}
          if (k === 'theme' && v === 'system') delete document.documentElement.dataset.theme;
          else if (k !== 'stage') document.documentElement.dataset[k] = v;
        }
        function click(e) {
          var b = e.target.closest && e.target.closest('[data-set]');
          if (!b || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
          e.preventDefault();
          put(b.dataset.set, b.dataset.value);
          var to = document.querySelector(b.dataset.focus);
          if (to) to.focus();
        }
        function change(e) {
          var t = e.target;
          if (t.matches('input[data-setting]')) {
            put(t.name, t.value);
            var sheet = t.closest('#settings');
            if (sheet && sheet.hidePopover) sheet.hidePopover();
          } else if (t.matches('input[data-todo]')) ticks[t.dataset.todo] = t.checked;
        }
        addEventListener('click', click);
        addEventListener('change', change);
        window.lfgEarly = function () {
          removeEventListener('click', click);
          removeEventListener('change', change);
        };
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__row">
        {/* The sun mark (CSS, the Ask screen's sun in small) on every screen; the name beside it from 600px. Both chips open the settings sheet (a native popover). */}
        <a class="site-name" href="/">
          <span class="sun-mark" aria-hidden="true"></span>
          <span class="site-name__text">{site}</span>
        </a>
        {/* The short name ("Series X") or "Pick console". The full name ("Console: Xbox Series X, change") is the aria-label, kept current by settings.js; no visible
            label word, because axe wants the visible text to sit whole inside the name and "Console" would split "Xbox Series X". */}
        <button class="chip chip--console needs-js" type="button" popovertarget="settings" aria-label="Pick console, change">
          <span class="chip__v">
            {Object.entries(consoles).map(([id, c]) => <span data-c={id}>{c.short}</span>)}
            <span data-c="">Pick console</span>
          </span>
        </button>
        {/* A small label over the level word, which is always there. The aria-label is "Spoilers: Off, change"; without script the chip still opens the sheet, where the dial is. */}
        <button class="chip chip--dial" type="button" popovertarget="settings" aria-label="Spoilers: Off, change">
          <span class="chip__k">Spoilers:</span>
          <span class="chip__v">{dial.map(([value, label]) => <span data-d={value}>{label}</span>)}</span>
        </button>
      </div>
    </header>

    <div id="settings" class="sheet" popover role="dialog" aria-labelledby="settings-title">
      <div class="sheet__in">
        <h2 id="settings-title">Settings</h2>
        <fieldset class="levels">
          <legend>Spoilers</legend>
          {dial.map(([value, label, meaning]) => (
            <label><input type="radio" name="dial" value={value} data-setting checked={value === 'off'} /><span><strong>{label}</strong> {meaning}</span></label>
          ))}
          <p class="levels__why">Off names a game system only to say it exists; where you could lose something, Off says so and one tap shows how to avoid it.</p>
        </fieldset>
        <fieldset class="setting needs-js">
          <legend>Console</legend>
          <div class="seg">
            {consoleIds.map((id) => (
              <label><input type="radio" name="console" value={id} data-setting /><ConsoleName id={id} /></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="setting needs-js">
          <legend>Theme</legend>
          <div class="seg">
            {themes.map(([value, label]) => (
              <label><input type="radio" name="theme" value={value} data-setting checked={value === 'system'} />{label}</label>
            ))}
          </div>
        </fieldset>
        <div class="sheet__done"><button type="button" class="btn" popovertarget="settings" popovertargetaction="hide">Done</button></div>
      </div>
    </div>

    {/* Only while the device is offline (online.js); empty and hidden otherwise. */}
    <p id="offline" class="offline-note" role="status" hidden></p>

    <div class:list={['frame', { 'frame--list': hasList }]}>
      <nav class="nav" aria-label="Main">
        {nav.map(({ href, label }) => (
          <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      {hasList && <aside class="list" aria-label="More in this topic"><slot name="list" /></aside>}
      <main class="main"><slot /></main>
    </div>

    <footer class="site-footer">
      <p>
        Leonida Field Guide is an unofficial fan project. It is not affiliated with or endorsed by
        Rockstar Games or Take-Two Interactive.
      </p>
      <a class="footer-link" href="/about/">About</a>
    </footer>

    <script>
      import '../scripts/settings.js';
      import '../scripts/sync.js';
      import '../scripts/offline.js';
      import '../scripts/online.js';
      import '../scripts/panel.js';
    </script>
  </body>
</html>
