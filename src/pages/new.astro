---
import Base from '../layouts/Base.astro';
import { newEntries } from '../data/new';

const entries = [...newEntries].sort((a, b) => b.date.localeCompare(a.date));
const problems = entries.flatMap((e) => e.problems);
---

<Base title="New" description="What changed in recent refreshes, and known problems with fixes.">
  <h1>What's new</h1>
  <!-- Shown by src/scripts/offline.js once the cache is complete. Hidden without JS. -->
  <p class="offline" data-offline hidden>Works offline. The guide is saved on this device.</p>

  <section class="entry">
    <h2>Known problems</h2>
    {problems.length === 0 ? (
      <>
        <p>No game-wide problems are confirmed yet. If the game crashes, there are steps to try.</p>
        <ul class="tap-list"><li><a href="/a/crashes-and-launch-problems/">What to do if the game crashes</a></li></ul>
      </>
    ) : (
      <ul class="problems">
        {problems.map((p) => (
          <li>{p.text} <span class="fix"><strong>Fix:</strong> {p.fix}</span></li>
        ))}
      </ul>
    )}
  </section>

  {entries.filter((e) => e.changed.length > 0).map((e) => (
    <section class="entry">
      <h2><time datetime={e.date}>{e.date}</time></h2>
      <h3>Changed</h3>
      <ul>{e.changed.map((c) => <li>{c}</li>)}</ul>
    </section>
  ))}
</Base>

<style>
  .offline {
    margin-block: 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }
  .entry { margin-block-start: var(--space-5); max-inline-size: 40rem; }
  .entry h2 { margin-block: 0 var(--space-2); }
  .entry time { font-family: var(--font-mono); }
  .entry h3 { margin-block: var(--space-3) var(--space-1); font-size: var(--text-body); color: var(--muted); }
  .entry ul:not(.tap-list) { margin-block: 0; padding-inline-start: var(--space-5); display: grid; gap: var(--space-2); }
  .fix { display: block; }
</style>
