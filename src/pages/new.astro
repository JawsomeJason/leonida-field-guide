---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { newEntries } from '../data/new';

// The no-problems line is a claim, so it names the answer that carries its sources and the day that answer was checked.
const crash = (await getCollection('answers')).find((e) => e.id === 'crashes-and-launch-problems')!.data;
const checked = new Date(`${crash.checked}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// Players read the latest few dates, three lines each (tests/content/new.test.mjs holds the data to the same limits).
const entries = [...newEntries].sort((a, b) => b.date.localeCompare(a.date));
const LATEST_DATES = 3, LINES_PER_DATE = 3;
const problems = entries.flatMap((e) => e.problems);
---

<Base title="Known problems and what changed" description="Known problems with fixes, and what changed in recent refreshes.">
  <h1>Known problems and what changed</h1>
  <!-- Shown by src/scripts/offline.js once the cache is complete. Hidden without JS. -->
  <p class="offline" data-offline hidden>Works offline. The guide is saved on this device.</p>

  <section class="entry">
    <h2>Known problems</h2>
    {problems.length === 0 ? (
      <>
        <p>No game-wide problems are confirmed yet. We checked on <time datetime={crash.checked}>{checked}</time>; where we looked is listed in the answer below. If the game crashes, there are steps to try.</p>
        <ul class="tap-list"><li><a href="/a/crashes-and-launch-problems/">What to do if the game crashes, and where we checked</a></li></ul>
      </>
    ) : (
      <ul class="problems">
        {problems.map((p) => (
          <li>{p.text} <span class="fix"><strong>Fix:</strong> {p.fix}</span></li>
        ))}
      </ul>
    )}
  </section>

  {entries.filter((e) => e.changed.length > 0).slice(0, LATEST_DATES).map((e) => (
    <section class="entry">
      <h2><time datetime={e.date}>{new Date(`${e.date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></h2>
      <ul>{e.changed.slice(0, LINES_PER_DATE).map((c) => <li>{c}</li>)}</ul>
    </section>
  ))}
</Base>

<style>
  .offline {
    margin-block: 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line); /* information, not a warning: neutral edge on a quiet surface, no accent */
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: var(--font-label);
  }
  .entry { margin-block-start: var(--space-5); max-inline-size: 40rem; }
  .entry h2 { margin-block: 0 var(--space-2); }
  .entry ul:not(.tap-list) { margin-block: 0; padding-inline-start: var(--space-5); display: grid; gap: var(--space-2); }
  .fix { display: block; }
</style>
