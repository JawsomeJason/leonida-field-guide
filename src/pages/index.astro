---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import MostAsked from '../components/MostAsked.astro';
import StagePicker from '../components/StagePicker.astro';
import NextUp from '../components/NextUp.astro';
import { todosOf } from '../lib/answers';

// Only `none` records reach this page: hidden-tier text must never be in a default page.
const answers = (await getCollection('answers', (a) => a.data.tier === 'none'))
  .map((a) => a.data)
  .sort((a, b) => a.question.localeCompare(b.question));
const todos = todosOf(answers);
---

<Base>
  <div class="home"><div class="home__grid">
    <div class="home__ask">
      {/* The sunset motif (another worker) goes on the next line. */}
      <h1 id="ask-title" tabindex="-1">Ask the field guide</h1>
      <p class="lede">Plain answers about setup, settings and getting started. Spoilers stay off until you turn them on.</p>
      <Search answers={answers} />
      <NextUp todos={todos} />
      <MostAsked answers={answers} />
    </div>
    <div class="home__stage"><StagePicker todos={todos} /></div>
  </div></div>
</Base>

<style>
  /* Phone and tablet: one column. With room, the questions sit beside the player's stage, so the width is used and nothing is stretched. */
  .home { container-type: inline-size; }
  @container (min-width: 48rem) {
    .home__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  }
</style>
