---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { stages } from '../data/stages';
import OtherConsoles from '../components/OtherConsoles.astro';
import { onlyOf } from '../lib/console.js';
import { todosOf } from '../lib/answers';

// Default page: `none` tier only, so a hidden to-do never reaches this HTML.
const todos = todosOf((await getCollection('answers')).map((e) => e.data)); // the same order as the Ask screen
const groups = stages.map((s) => ({ ...s, items: todos.filter((a) => a.stage === s.id) }));
const noun = (n: number) => `${n} to-do${n === 1 ? '' : 's'}`;
---

<Base title="Checklist" description="Your to-dos, by stage of play.">
  <h1>Your checklist</h1>

  {todos.length === 0 ? (
    <p>No to-dos yet. Check back after the next refresh.</p>
  ) : (
    <div class="overall" data-overall>
      <p class="overall__text"><span data-count>{noun(todos.length)}</span></p>
      <progress class="needs-js" max={todos.length} value="0" aria-label="Overall progress"></progress>
    </div>
  )}

  <p class="sync" role="status" data-sync>Syncing is not available here. Your ticks are saved on this device only.</p>

  <div class="stages"><div class="stages__grid">
  {groups.map((g) => (
    <section class="stage" data-stage aria-labelledby={g.id}>
      <h2 id={g.id}>{g.label}</h2>
      {g.items.length === 0 ? (
        <p class="quiet">Nothing here yet.</p>
      ) : (
        <>
          <p class="quiet"><span data-count>{noun(g.items.length)}</span></p>
          <progress class="needs-js" max={g.items.length} value="0" aria-label={`${g.label} progress`}></progress>
          <ul class="tap-list todos">
            {g.items.map((a) => (
              <li class="todo" data-only={onlyOf(a.consoles)}>
                <a class="todo__go" href={`/a/${a.id}/`}>{a.todo}</a>
                <label class="todo__tick needs-js">
                  <input type="checkbox" value={a.id} data-todo />
                  <span>{a.todo}</span>
                </label>
                <a class="todo__open needs-js" href={`/a/${a.id}/`} aria-label={`Open answer: ${a.todo}`}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              </li>
            ))}
          </ul>
          <OtherConsoles items={g.items.map((a) => ({ ...a, label: a.todo! }))} />
        </>
      )}
    </section>
  ))}
  </div></div>

  <details class="backup needs-js" id="backup">
    <summary>Back up or move your progress</summary>
    <div class="backup__body">
      <p class="quiet">The code is text that holds your ticks only: console, theme and spoiler level stay on each device. Copying it sends it nowhere by itself. Paste it on the other device to add those ticks there.</p>

      <label for="export-code">Your code</label>
      <textarea id="export-code" rows="4" readonly spellcheck="false" autocomplete="off"></textarea>
      <button type="button" class="btn" id="copy-code">Copy code</button>
      <p class="note" id="export-note" role="status"></p>

      <label for="import-code">Restore from a code</label>
      <textarea id="import-code" rows="4" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="Paste a code here"></textarea>
      <button type="button" class="btn" id="import-go">Restore progress</button>
      <p class="note" id="import-note" role="status"></p>
    </div>
  </details>

  <script>
    import '../scripts/checklist.js';
  </script>
</Base>

<style>
  .quiet { color: var(--muted); margin-block: 0 var(--space-2); }
  /* One quiet line. Same height whichever text it holds, so the page below never moves. */
  .sync { min-block-size: 3.9em; margin-block: var(--space-2) 0; color: var(--muted); font: var(--font-label); } /* room for the sentence: it appears when the first sync ends, and the page must not jump */
  @media (min-width: 36rem) { .sync { min-block-size: 2.6em; } }
  :global(html.js) .sync:not([data-state]) { visibility: hidden; } /* script is running and has not heard from the store yet: claim nothing */
  /* Rows stay about 70 characters wide, whole-row targets. With room, the four stages sit in two columns instead of one long stretched list. */
  .stages { container-type: inline-size; }
  @container (min-width: 56rem) {
    .stages__grid { columns: 2; column-gap: var(--space-6); }
    .stage { break-inside: avoid; }
  }
  .overall, .stage, .backup { max-inline-size: 70ch; }
  /* Padding, not margin: a margin at the top of the second column is cut off, so the two columns would start at different heights. */
  .stage { padding-block-start: var(--space-5); }
  .stage h2 { margin-block: 0 var(--space-1); }

  /* Without JS the page is a list of links; JS swaps in the tick rows. */
  :global(html.js) .todo__go { display: none; }
  :global(html.js) .todo { display: flex; gap: var(--space-4); } /* 16px: a tap beside the arrow ticks nothing and opens nothing */
  .todo__tick {
    flex: 1 1 auto;
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--tap);
    margin-block: calc(var(--gap-tap) / 2);
    margin-inline: calc(var(--space-2) * -1) 0;
    padding: var(--space-2);
    cursor: pointer;
  }
  .todo__tick:has(:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  /* Done: colour and a line through, never a change of size. */
  .todo__tick:has(:checked) span { color: var(--muted); text-decoration: line-through; }
  .todo__open { flex: none; inline-size: var(--tap); justify-content: center; margin-inline: 0; padding: 0; border-inline-start: 0; color: var(--muted); }

  /* Progress: a thin bar, filled with the accent. The count beside it is the real information. */
  progress {
    appearance: none;
    display: block;
    inline-size: 100%;
    block-size: 0.5rem;
    margin-block: var(--space-2) var(--space-3);
    border: 0 solid;
    border-radius: 0.25rem;
    overflow: clip;
    background: var(--line);
  }
  progress[hidden] { display: none; }
  progress::-webkit-progress-bar { background: transparent; }
  progress::-webkit-progress-value { background: var(--accent); }
  progress::-moz-progress-bar { background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    progress::-webkit-progress-value { transition: inline-size 0.2s cubic-bezier(0.23, 1, 0.32, 1); }
  }
  .overall__text { margin: 0; font: 600 var(--text-h2) / 1.3 var(--font-text); }

  .backup { margin-block: var(--space-6) var(--space-4); }
  .backup summary {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-inline: 0;
    border-block: 1px solid var(--line);
    color: var(--accent);
    cursor: pointer;
  }
  .backup__body { display: grid; gap: var(--space-2); padding-block-start: var(--space-4); max-inline-size: 40rem; }
  .backup label { font: var(--font-label); color: var(--muted); margin-block-start: var(--space-3); }
  .backup textarea {
    inline-size: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    word-break: break-all;
    resize: vertical;
  }
  .note { min-block-size: 1.5em; margin: 0; }
  .note[data-error] { color: var(--accent-2); }
</style>
