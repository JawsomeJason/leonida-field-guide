---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { topics } from '../../data/topics';
import { tileStates, tileRows } from '../../lib/topics.js';

const all = (await getCollection('answers')).map((e) => e.data);
// Per topic: how many records each tier holds. The count a tile shows follows the dial (CSS, html[data-dial]); with no script it is the default-tier count.
const counts = (id: string) => Object.fromEntries((['none', 'places', 'mild'] as const).map((t) => [t, all.filter((a) => a.topic === id && a.tier === t).length]));
const states = (id: string) => tileStates(counts(id));
const rows = (id: string) => tileRows(counts(id));
const chevron = { viewBox: '0 0 24 24', width: 20, height: 20 };
---

<Base title="Topics" description="Browse the guide by topic.">
  <h1>Topics</h1>
  <ul class="tiles">
    {topics.map((t) => t.id === 'places' ? (
      <li>
        <a class="tile tile--places" href={`/topics/${t.id}/`}>
          <span class="tile__name">{t.label}</span>
          <span class="tile__end">
            <span class="tile__meta">
              <span class="locked">Hidden until the spoiler setting is raised to Places. That adds where things are.</span>
              <span class="open">Shown, because the spoiler setting is Places or higher.</span>
            </span>
            <svg {...chevron} aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      </li>
    ) : (
      states(t.id).every((s) => s.count > 0) ? (
        /* Opens at every level: one link, with the count for each level inside it (the dial picks which shows). */
        <li>
          <a class="tile" href={`/topics/${t.id}/`}>
            <span class="tile__name">{t.label}</span>
            <span class="tile__end">
              <span class="tile__meta">{states(t.id).map((s) => <span data-levels={s.levels}>{s.count} {s.count === 1 ? 'answer' : 'answers'}</span>)}</span>
              <svg {...chevron} aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        </li>
      ) : (
        /* Nothing opens at Off: a quiet row that says where the answers are, and one link row for the levels that open them. Its count is never in this page; the script fills it from the hidden index once the dial reaches it. A topic with nothing anywhere says so. */
        rows(t.id).map((s) => (
          <li data-levels={s.levels}>
            {s.open ? (
              <a class="tile" href={`/topics/${t.id}/`}>
                <span class="tile__name">{t.label}</span>
                <span class="tile__end">
                  <span class="tile__meta" data-count-topic={t.id}></span>
                  <svg {...chevron} aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
            ) : (
              <div class="tile tile--closed">
                <span class="tile__name">{t.label}</span>
                <span class="tile__meta">{s.until ? `Hidden until ${s.until}` : 'No answers yet'}</span>
              </div>
            )}
          </li>
        ))
      )
    ))}
  </ul>
</Base>

<script>
  import '../../scripts/topic-counts.js';
</script>

<style>
  /* Topic rows: plain (secondary), a hairline between them, the name and its count on one line. */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-tap); max-inline-size: 40rem; }
  .tiles li { position: relative; }
  .tiles li:not(:last-child, :has(.tile--places))::after { content: ''; position: absolute; inset-inline: 0; inset-block-end: calc(var(--gap-tap) / -2 - 0.5px); border-block-end: 1px solid var(--line); pointer-events: none; }
  /* A count, or a whole row, exists once per distinct state; the dial picks the one that shows. No script: Off. */
  .tiles [data-levels] { display: none; }
  :global(html:not([data-dial='places'], [data-dial='mild'])) .tiles [data-levels~='off'],
  :global(html[data-dial='places']) .tiles [data-levels~='places'],
  :global(html[data-dial='mild']) .tiles [data-levels~='mild'] { display: revert; }
  /* Every row is one tap target, 8px clear of the next (the list's own gap, with the hairline in the middle). */
  .tile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    min-block-size: var(--tap);
    margin-inline: calc(var(--space-2) * -1);
    padding: var(--space-2);
    color: var(--text);
    text-decoration: none;
    touch-action: manipulation;
  }
  .tile__name { font-weight: 650; line-height: 1.3; }
  .tile__meta { color: var(--muted); font: var(--font-label); }
  .tile__end { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--muted); } /* the same chevron the Ask and Checklist rows end on */
  .tile--closed { color: var(--muted); } /* not a link, not a target: a quiet row with no chevron */
  /* Two columns where there is room; the Places row spans both. */
  @media (min-width: 64rem) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); max-inline-size: 64rem; }
    .tiles li:has(.tile--places) { grid-column: 1 / -1; }
  }
  /* Dashed edge means "hidden until you ask", here and on the Show controls. It is the one topic row with an outline. */
  .tiles li:has(.tile--places) { margin-block-start: var(--space-3); }
  .tile--places { margin-inline: 0; padding-inline: var(--space-4); border: 1px dashed var(--muted); border-radius: var(--radius); }
  .open { display: none; }
  :global(html:is([data-dial='places'], [data-dial='mild'])) .tile--places { border-style: solid; border-color: var(--line); }
  :global(html:is([data-dial='places'], [data-dial='mild'])) .locked { display: none; }
  :global(html:is([data-dial='places'], [data-dial='mild'])) .open { display: inline; }
</style>
