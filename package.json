{
  "name": "leonida-field-guide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run build && npm run test:unit && npm run check:leak && npm run check:links && npm run check:answer-links && npm run check:console && npm run check:dates && npm run check:facts && npm run check:search && npm run test:e2e",
    "test:unit": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "check:leak": "node scripts/check-leak.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:answer-links": "node scripts/check-answer-links.mjs",
    "check:console": "node scripts/check-console-text.mjs",
    "check:dates": "node scripts/check-dates.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "check:search": "node scripts/check-search-questions.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "astro": "^7.4.13",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3"
  }
}
